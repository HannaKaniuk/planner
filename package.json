{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.8",
  "scripts": {
    "dev": "node server/next-with-socket.js",
    "build": "next build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/next-with-socket.js",
    "migration:create": "tsx node_modules/@mikro-orm/cli/cli migration:create --config mikro-orm.config.cjs",
    "migration:up": "tsx node_modules/@mikro-orm/cli/cli migration:up --config mikro-orm.config.cjs",
    "migration:down": "tsx node_modules/@mikro-orm/cli/cli migration:down --config mikro-orm.config.cjs",
    "migration:pending": "tsx node_modules/@mikro-orm/cli/cli migration:pending --config mikro-orm.config.cjs",
    "backup-db": "tsx scripts/backup-db.ts",
    "server": "node server/server.js"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.6.5",
    "@mikro-orm/migrations": "^6.6.5",
    "@mikro-orm/sqlite": "^6.6.5",
